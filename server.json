{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RostislavMatov/mcpcut",
  "title": "mcpcut",
  "description": "Journals every MCP tool call with secrets redacted; with a policy, holds risky calls for approval",
  "repository": {
    "url": "https://github.com/RostislavMatov/mcpcut",
    "source": "github"
  },
  "websiteUrl": "https://mcpcut.com",
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mcpcut",
      "version": "0.3.0",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "wrap"
        },
        {
          "type": "named",
          "name": "--server",
          "description": "A short name for the wrapped server in the journal and the approval queue, e.g. fs",
          "valueHint": "server_name",
          "isRequired": true
        },
        {
          "type": "positional",
          "value": "--"
        },
        {
          "type": "positional",
          "valueHint": "server_command",
          "description": "The command that starts the MCP server to put behind mcpcut, e.g. npx",
          "isRequired": true
        },
        {
          "type": "positional",
          "valueHint": "server_arg",
          "description": "Its arguments, one per value, e.g. -y, then @modelcontextprotocol/server-filesystem, then your project path",
          "isRepeated": true
        }
      ]
    }
  ]
}
