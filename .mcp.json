{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "<path-to-mcpcut>/dist/cli.js",
        "wrap",
        "--server",
        "playwright",
        "--",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "memory": {
      "command": "node",
      "args": [
        "<path-to-mcpcut>/dist/cli.js",
        "wrap",
        "--server",
        "memory",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    }
  }
}
