{
  "mcpServers": {
    "github-cp": {
      "command": "node",
      "args": [
        "<path-to-mcpcut>/dist/cli.js",
        "connect",
        "github",
        "--agent",
        "smoke-agent"
      ],
      "env": {
        "MCP_AGENT_TOKEN": "<agent-token-from-agent-create>"
      }
    },
    "playwright": {
      "command": "node",
      "args": [
        "<path-to-mcpcut>/dist/cli.js",
        "wrap",
        "--server",
        "playwright",
        "--",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "memory": {
      "command": "node",
      "args": [
        "<path-to-mcpcut>/dist/cli.js",
        "wrap",
        "--server",
        "memory",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    }
  }
}
