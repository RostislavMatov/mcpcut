# Build output and dependencies are produced inside the image, never copied in.
node_modules
dist
coverage

# Tests are excluded from the build (tsconfig `exclude`) and never shipped.
tests
vitest.config.ts

# Repository furniture that has no business in a runtime image.
.git
.github
.claude
docs
*.md

# Local state that must never leak into an image layer: the journal directory
# holds proxied traffic, the vault and the installation's signing key.
.mcp-journal
*.db
*.db-wal
*.db-shm
.env
.env.*
