# Example systemd USER unit for the McpCut admin console (`mcpcut ui`).
#
# This is an example, not something `mcpcut` installs or reads. Copy it to
# ~/.config/systemd/user/mcpcut-ui.service, adapt the two paths in ExecStart
# and Environment, and follow docs/deploy/README.md. The install config it
# points at must say "supervisor": "external" (written by
# `mcpcut setup --yes --supervisor external`); otherwise `mcpcut start`/`stop`
# would fight this unit for the same process.

[Unit]
Description=McpCut admin console (mcpcut ui)
Documentation=file:%h/mcp-control-plane/README.md
After=network.target

[Service]
Type=simple
# %h is the home directory of the user the unit runs as. `env node` finds the
# node binary on the PATH of that user's systemd session; if node lives
# elsewhere (nvm, volta, /opt), replace `/usr/bin/env node` with its absolute
# path.
ExecStart=/usr/bin/env node %h/mcp-control-plane/dist/cli.js ui
Environment=MCPCUT_CONFIG=%h/.mcpcut/config.json
# The bind (host, port, --behind-tls, allowed hosts) comes from that config;
# a flag on the ExecStart line would outrank it, so keep the line bare.
Restart=on-failure
RestartSec=2s
# The CLI handles SIGTERM and lets in-flight journal batches commit before
# it exits; give it the same grace docker-compose.yml does.
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
# Every file the process creates is owner-only, like the data directory.
UMask=0077
# stdout/stderr go to the user journal: `journalctl --user -u mcpcut-ui`.
# `mcpcut logs ui` reads only <data dir>/run/ui.log, which this unit does not
# write; to have both, add
#   StandardOutput=append:%h/.mcp-journal/run/ui.log
#   StandardError=append:%h/.mcp-journal/run/ui.log
# after creating that directory with mode 0700.

[Install]
WantedBy=default.target
