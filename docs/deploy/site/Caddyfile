# mcpcut.com — the preview page, the hub (accounts, ADR-0017 phase 2) and
# every tenant install (ADR-0017 phase 3), on a host whose 443 belongs to
# another service. Exactly what runs on the project's own host; put your
# names where mcpcut.com stands.
#
# Everything here sits behind Cloudflare: proxied DNS records for
# `mcpcut.com`, `www`, `mcp`, and the wildcard `*`, plus one Origin Rule that
# sends HTTPS traffic for `mcpcut.com` and for every name under
# `*.mcpcut.com` (an expression such as `(http.host eq "mcpcut.com") or
# (http.host.wildcard("*.mcpcut.com"))`) to this host's :8443. One Cloudflare
# Origin CA certificate, issued for `mcpcut.com, *.mcpcut.com`, covers all of
# it. (The earlier caution here — issue the Origin CA for `mcpcut.com` and
# `www` only, never the wildcard, so Caddy would not skip Let's Encrypt for
# `mcp.mcpcut.com` — no longer applies: `mcp.mcpcut.com` moved behind the
# proxy too, below, so there is no Let's Encrypt certificate left to skip.)
# Certificate mode: Cloudflare SSL/TLS → Full (strict).
#
# Caddy itself decides which block below answers a given Host — a Caddyfile's
# site blocks are matched by specificity, not by file order — so the three
# explicit blocks (`mcpcut.com`/`www.mcpcut.com`, `mcp.mcpcut.com`) always win
# over the `*.mcpcut.com` wildcard block for their own name; nothing here
# needs a reload when a tenant is created or removed (O5):
#
#   https://mcpcut.com          the preview page, and the hub's routes
#                                (/signin, /auth/*, /account, /account/*,
#                                /signout, /terms, /privacy, /hub-assets/*).
#   https://mcp.mcpcut.com/mcp  the agent front of the OWNER'S OWN install —
#                                the one docker-compose.yml runs directly, not
#                                a tenant's. Proxied through Cloudflare like
#                                everything else now; the address handed to
#                                agents changed from
#                                `https://mcp.mcpcut.com:8443` to
#                                `https://mcp.mcpcut.com/mcp` when it moved.
#   https://<sub>.mcpcut.com    a tenant's own console;
#   https://<sub>.mcpcut.com/mcp  that tenant's agent front. `<sub>` selects
#                                the upstream container `mcpcut-t-<sub>` by
#                                name, on the tenant's own Docker network
#                                (which `provisioner` attaches this `caddy`
#                                container to when the tenant is created —
#                                O4). A subdomain nobody has provisioned
#                                resolves to no such container name: Caddy
#                                answers 502, never another tenant's.
#
# The admin UI of the OWNER'S OWN install is NOT published here: it stays on
# host loopback (127.0.0.1:8091). Reach it through a tunnel:
#   ssh -N -L 8091:127.0.0.1:8091 <user>@<host>
#
# admin off: Caddy joins every tenant's network (the provisioner connects it),
# so a tenant container is a network neighbour of this process. Nothing here
# reloads Caddy through its admin API — routes to tenants are resolved per
# request from the Host label — so the API is switched off rather than left on
# a loopback bind a future edit could widen. Config changes: restart Caddy.
{
	admin off
	http_port 80
	https_port 8443
}

(page_headers) {
	header {
		Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

mcpcut.com:8443, www.mcpcut.com:8443 {
	tls /etc/caddy/origin/cert.pem /etc/caddy/origin/key.pem
	# Cloudflare Authenticated Origin Pulls (H6, ADR-0017 phase 2): proves a
	# request at this vhost actually transited Cloudflare, so `CF-Connecting-
	# IP` below cannot be forged by hitting the origin IP directly and walking
	# straight through the hub's per-IP signup rate limit (HA12). Turn on
	# together with the matching zone setting (SSL/TLS → Origin Server →
	# Authenticated Origin Pulls): fetch Cloudflare's origin-pull CA to the
	# path below, then move this block inside the `tls` directive above
	# (`tls cert.pem key.pem { client_auth { ... } }`). Left commented so a
	# deploy that has not done the zone side yet does not go dark; the same
	# setting, once on, applies to the `mcp.mcpcut.com` and `*.mcpcut.com`
	# blocks below too — it is a zone-wide Cloudflare setting, not per-block.
	# client_auth {
	# 	mode require_and_verify
	# 	trust_pool file /etc/caddy/origin/cf-origin-pull-ca.pem
	# }
	@www host www.mcpcut.com
	redir @www https://mcpcut.com{uri} 301
	# hub (ADR-0017 phase 2, `mcpcut-hub`): sign-in and accounts. It sets its
	# own security headers (its CSP allows its own forms); the static page's
	# `page_headers` (form-action 'none') must NOT be applied to it, hence two
	# `handle` blocks rather than one site-wide `import`. `CF-Connecting-IP` is
	# an ordinary request header here — Caddy forwards it to the upstream as
	# received — which is exactly why the Authenticated Origin Pulls block above
	# matters: without it, that header is whatever a direct caller sends.
	@hub path /signin /auth/* /account /account/* /signout /terms /privacy /hub-assets/*
	handle @hub {
		reverse_proxy hub:8092
	}
	handle {
		import page_headers
		root * /srv/site
		file_server
	}
}

mcp.mcpcut.com:8443 {
	# The owner's own install (docker-compose.yml, not a tenant): reached
	# through Cloudflare's proxy like every other name here (ADR-0017 O6),
	# with the same Origin CA pair as the block above — no ACME/HTTP-01 step,
	# and so nothing here to keep off :443 (TLS-ALPN needs 443, which was the
	# reason this used to run its own Let's Encrypt certificate on :8443
	# directly). Cloudflare still cuts a response idle for 100 s; an agent
	# waiting on a human approval must not be cut — a live smoke watches this
	# (see the wildcard block below, which carries the same risk for tenants).
	tls /etc/caddy/origin/cert.pem /etc/caddy/origin/key.pem
	reverse_proxy serve:8090
}

# ADR-0017 phase 3: one block for every tenant, present before the first one
# is ever created and unchanged after the last one is removed — no Caddy
# reload on `provision-create`/`provision-remove` (O5).
# `{http.request.host.labels.2}` is the Host header's label, counting from
# the right and starting at 0 (Caddy's own indexing): for `smoke1.mcpcut.com`,
# label 0 is `com`, label 1 is `mcpcut`, label 2 is `smoke1` — the subdomain
# the provisioner named the tenant's container, network and volume after
# (`mcpcut-t-<sub>`, `hub/src/provisioner/templates.ts`). Caddy resolves that
# name on the tenant's own Docker network, which `provisioner` connects this
# `caddy` container to when the tenant is created; nothing here lists
# tenants, and this block never talks to Docker itself.
#
# `import page_headers` is deliberately absent: the console sets its own
# security headers (`src/ui/security-headers.ts`), tuned to its own forms,
# and this block fronts a different tenant's install on every request, not
# one static page.
*.mcpcut.com:8443 {
	tls /etc/caddy/origin/cert.pem /etc/caddy/origin/key.pem
	# Cloudflare cuts a response idle for 100 s (see the header comment); an
	# agent of this tenant waiting on a human approval must not be cut. A live
	# smoke exercises an approval close to that limit.
	@agent path /mcp /mcp/*
	handle @agent {
		reverse_proxy mcpcut-t-{http.request.host.labels.2}:8090
	}
	handle {
		reverse_proxy mcpcut-t-{http.request.host.labels.2}:8091
	}
}
